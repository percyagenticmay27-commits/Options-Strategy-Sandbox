[Unit]
Description=Strategy B independent paper purchase and management scans

[Timer]
# Watchdog only. Every successful collector publication invokes
# refresh_recovery.py immediately; these ticks NEVER recycle old quotes.
# Keep an early post-collector status check and afternoon management watchdog.
OnCalendar=Mon..Fri *-*-* 10:35:00 America/Chicago
OnCalendar=Mon..Fri *-*-* 11:25:00 America/Chicago
OnCalendar=Mon..Fri *-*-* 14:25:00 America/Chicago
OnCalendar=Mon..Fri *-*-* 14:30:00 America/Chicago
AccuracySec=5s
Persistent=false
Unit=options-sandbox-observer.service

[Install]
WantedBy=timers.target
