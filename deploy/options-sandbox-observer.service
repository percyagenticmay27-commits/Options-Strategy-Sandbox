[Unit]
Description=Strategy B independent local paper purchase and risk management
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Options-Strategy-Sandbox
ExecStart=/usr/bin/python3 %h/Options-Strategy-Sandbox/scheduled_cycle.py
TimeoutStartSec=45s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
